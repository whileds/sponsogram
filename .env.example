# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/sponsogram_cip?schema=public"

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"
# Base URL of the deployed app (used for callback URLs)
AUTH_URL="http://localhost:3000"

# --- Razorpay ---
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="replace-with-razorpay-secret"
RAZORPAY_WEBHOOK_SECRET="replace-with-webhook-secret"
# Publishable key needed client-side for Razorpay Checkout — safe to expose
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"

# --- Email notifications (optional — sendNotification() no-ops if unset) ---
RESEND_API_KEY=""
NOTIFICATIONS_FROM_EMAIL="noreply@sponsogram.com"

# --- Seed script ---
SEED_ADMIN_EMAIL="admin@sponsogram.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
